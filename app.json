{
  "expo": {
    "name": "Dentli",
    "slug": "dentli",
    "version": "1.0.0",
    "description": "Local-first dental care tracking for routines, symptoms, appointments, tooth history, and gentle reminders.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dentli",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#081824"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dentli.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Dentli",
        "NSUserNotificationsUsageDescription": "Dentli uses notifications for brushing, flossing, appointment, and care reminders that you choose to enable."
      }
    },
    "android": {
      "package": "com.dentli.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0F7B6C"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
